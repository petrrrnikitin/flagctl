# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=flagctl
POSTGRES_PASSWORD=secret
POSTGRES_DB=flagctl

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
# External port for local tools (kcat, kafka-ui, etc.)
KAFKA_PORT=29092

# ─── Auth Service (gRPC, internal only) ───────────────────────────────────────
AUTH_GRPC_HOST=auth
AUTH_GRPC_PORT=50051

# ─── Evaluator Service (gRPC, internal only) ──────────────────────────────────
EVALUATOR_GRPC_HOST=evaluator
EVALUATOR_GRPC_PORT=50052

# ─── API Gateway ──────────────────────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=change_me_in_production
APP_PORT=8080

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_TTL=3600
JWT_REFRESH_TTL=604800